# Upstash Redis configuration (Optional for local development; when unset, local storage fallback is used)
# Obtain these from your Upstash console (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
